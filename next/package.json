{
  "name": "wrkbench",
  "version": "0.3.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "features/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "build:single": "WRKBENCH_SINGLE_HTML=1 rsbuild build && node scripts/inline-html.mjs",
    "preview": "rsbuild preview",
    "typecheck": "tsc --noEmit",
    "test:core": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "bun run typecheck && bun run test:core && bun run build && bun run test:e2e",
    "static:verify": "node scripts/static-verify.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@rsbuild/core": "^1.7.5",
    "@rsbuild/plugin-react": "^1.4.6",
    "@tailwindcss/postcss": "^4.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "cordis": "4.0.0-rc.12",
    "dockview": "^8.8.3",
    "dockview-react": "^8.8.3",
    "i18next": "^25.6.0",
    "lucide-react": "^1.11.0",
    "motion": "^12.23.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^16.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.3",
    "wouter": "^3.7.0",
    "zustand": "^5.0.8",
    "zod": "^4.3.6",
    "monaco-editor": "^0.55.1",
    "@radix-ui/react-tooltip": "^1.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
